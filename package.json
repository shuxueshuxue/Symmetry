{
  "name": "symmetry",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --exclude \"tests/slow/**\" --exclude \"node_modules/**\"",
    "audit:layout": "node tests/layout/audit.mjs",
    "cli": "node cli/main.ts",
    "build:cli": "esbuild cli/main.ts --bundle --platform=node --format=esm --target=node18 --outfile=bin/symmetry.mjs",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "playwright-core": "^1.59.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "bin": {
    "symmetry": "bin/symmetry.mjs"
  }
}
